{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rig.schema.json",
 "title": "Rig config",
 "description": "Config of pipeline/rig/prepare_rig.py (`rig_config` in character.json). World coordinates of the rest pose in m. Keys starting with _ are comments; unknown keys are allowed.",
 "type": "object",
 "required": ["joints"],
 "properties": {
  "joints": {"type": "string", "description": "joints JSON written by auto_rig.py, relative to this file"},
  "prop": {
   "type": "object",
   "required": ["name", "parent", "select", "frame", "debris"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "parent": {"type": "string", "minLength": 1},
    "select": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "close_islands": {"type": "number"},
    "frame": {
     "type": "object",
     "required": ["axis", "origin", "up"],
     "properties": {"axis": {"$ref": "#/$defs/pair"}, "origin": {"$ref": "#/$defs/vec3"}, "up": {"$ref": "#/$defs/vec3"}}
    },
    "grow": {
     "type": "object",
     "required": ["steps", "thickness", "margin"],
     "properties": {"steps": {"type": "integer"}, "thickness": {"type": "number"}, "margin": {"type": "number"}}
    },
    "debris": {
     "type": "object",
     "required": ["max_vertices", "box"],
     "properties": {"max_vertices": {"type": "integer"}, "box": {"$ref": "#/$defs/pair"}}
    }
   }
  },
  "fingers": {
   "type": "object",
   "required": ["claw_thresholds", "base", "base_band", "min_vertices", "weight_blend"],
   "properties": {
    "claw_thresholds": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "base": {"type": "number"},
    "base_band": {"$ref": "#/$defs/range"},
    "min_vertices": {"type": "integer"},
    "weight_blend": {"$ref": "#/$defs/range"},
    "thumb": {"type": "object", "properties": {"Left": {"type": "integer"}, "Right": {"type": "integer"}}}
   }
  }
 },
 "$defs": {
  "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
  "pair": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2, "maxItems": 2},
  "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
  "rule": {
   "type": "object",
   "description": "vertices matching every given test: within r of the tube line / segment, inside box, outside each exclude box",
   "properties": {
    "tube": {"$ref": "#/$defs/pair"},
    "segment": {"$ref": "#/$defs/pair"},
    "r": {"type": "number"},
    "box": {"$ref": "#/$defs/pair"},
    "exclude": {"type": "array", "items": {"$ref": "#/$defs/pair"}}
   },
   "dependentRequired": {"tube": ["r"], "segment": ["r"]}
  }
 }
}
