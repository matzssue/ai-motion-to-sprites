{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "motion.schema.json",
 "title": "Motion file",
 "description": "One action: Kimodo phases and key poses, and/or the prop grip for prop_in_hands.py. Keys starting with _ are comments; unknown keys are allowed. character.py also requires `phases` for an `ai` action and `grip` for a `prop` action.",
 "type": "object",
 "required": ["action"],
 "properties": {
  "action": {"type": "string", "minLength": 1},
  "phases": {
   "type": "array", "minItems": 1,
   "items": {"type": "object", "required": ["duration", "text"],
             "properties": {"duration": {"type": "number"}, "text": {"type": "string", "minLength": 1}}}
  },
  "tail_padding": {"type": "number"},
  "loop_blend_s": {"type": "number"},
  "root_speed": {"type": "number"},
  "no_aim": {"type": "boolean"},
  "key_poses": {
   "type": "object",
   "description": "pose name -> frame at 24 fps; the first one starts and ends the clip",
   "patternProperties": {"^[^_]": {"type": "integer"}}
  },
  "hands": {
   "type": "object",
   "required": ["windows", "right_target_from_shoulder", "left_from_right"],
   "properties": {
    "windows": {"type": "array", "items": {
     "type": "object", "required": ["from", "to", "every", "mode"],
     "properties": {"from": {"type": "number"}, "to": {"anyOf": [{"type": "number"}, {"const": "end"}]},
                    "every": {"type": "number"}, "mode": {"type": "string"}}}},
    "right_target_from_shoulder": {"$ref": "#/$defs/vec3"},
    "left_from_right": {"$ref": "#/$defs/vec3"}
   }
  },
  "grip": {
   "type": "object",
   "required": ["palm_center", "clearance", "stock_radius_max", "right", "left", "elbow_deg", "twist_to_forearm",
                "forearm_clearance", "hand_clearance", "finger_thickness"],
   "properties": {
    "palm_center": {"type": "number"}, "clearance": {"type": "number"}, "stock_radius_max": {"type": "number"},
    "right": {"$ref": "#/$defs/hand"}, "left": {"$ref": "#/$defs/hand"},
    "elbow_deg": {"type": "number"}, "twist_to_forearm": {"type": "number"}, "forearm_clearance": {"type": "number"},
    "hand_clearance": {"type": "number"}, "finger_thickness": {"type": "number"},
    "max_offset": {"type": "number"}, "offset_penalty": {"type": "number"}, "finger_change_penalty": {"type": "number"},
    "change_penalty": {"type": "number"}, "passes": {"type": "integer"}, "face_guard": {"type": "boolean"}
   }
  },
  "hold": {
   "type": "object",
   "required": ["yaw_deg", "pitch_deg", "above_hips", "body_clearance"],
   "properties": {"yaw_deg": {"type": "number"}, "pitch_deg": {"type": "number"}, "above_hips": {"type": "number"},
                  "body_clearance": {"type": "number"}}
  },
  "aim": {
   "type": "object",
   "properties": {"butt_from_shoulder": {"$ref": "#/$defs/vec3"}, "butt_push": {"$ref": "#/$defs/vec3"}, "pitch_deg": {"type": "number"},
                  "head_back_deg": {"type": "number"}, "transition_arc": {"type": "number"}, "head_gaze": {"type": "number"}}
  },
  "recoil": {
   "type": "object",
   "required": ["fire_s", "kick_deg", "lean_deg"],
   "properties": {"fire_s": {"type": "number"}, "kick_deg": {"type": "number"}, "lean_deg": {"type": "number"}}
  }
 },
 "$defs": {
  "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
  "axis": {"enum": ["forward", "back", "left", "right", "up", "down"]},
  "hand": {
   "type": "object",
   "required": ["x"],
   "properties": {
    "x": {"type": "number"},
    "palm": {"enum": ["from below", "from above", "from the right", "from the left", "from behind", "from the front"]},
    "palm_normal": {"$ref": "#/$defs/vec3"},
    "fingers": {"$ref": "#/$defs/axis"},
    "fingers_tilt": {"type": "array", "prefixItems": [{"$ref": "#/$defs/axis"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "direction": {"$ref": "#/$defs/vec3"},
    "roll_deg": {"type": "number"},
    "elbow_target": {"$ref": "#/$defs/vec3"},
    "elbow_target_weight": {"type": "number"},
    "knuckles_at_edge": {"type": "boolean"}
   },
   "allOf": [
    {"description": "give the palm side in words (`palm`) or as a vector (`palm_normal`)",
     "anyOf": [{"required": ["palm"]}, {"required": ["palm_normal"]}]},
    {"description": "give the finger direction in words (`fingers`) or as a vector (`direction`)",
     "anyOf": [{"required": ["fingers"]}, {"required": ["direction"]}]}
   ]
  }
 }
}
